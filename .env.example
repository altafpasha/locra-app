# ==============================================================================
# Locra AI — environment template
# Copy to `.env` for local dev:  cp .env.example .env
# In production these are injected by the GitHub Actions deploy from repo secrets.
# NEVER commit a real .env.
# ==============================================================================

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Travel AI Extractor API — key is sent upstream as the `X-API-Key` header
TRAVEL_AI_API_KEY=replace-with-your-key
TRAVEL_AI_API_URL=https://travel-api.codesec.me
